# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# Environment files
.env
.env.*
!.env.example

# Prisma local tooling environment — never commit
/prisma/.env

# logs
npm-debug.log*
yarn-error.log*

# Generated audit output: `npm audit --json` snapshots are reproducible on demand and stale on arrival.
# They describe an unpatched dependency posture and must not enter permanent public history.
/audit-production.json

# misc
.DS_Store
*.pem
/coverage
/.vercel

# Prisma: the generated client is a build artefact, produced by `prisma generate` in the deployment
# pipeline. The schema and every migration under prisma/ ARE committed — they are the source of truth
# for the database, not build output. node_modules/.prisma is already covered above.
/.prisma
/generated

# Exvisit workspace metadata (not part of the application)
/.exvisit
