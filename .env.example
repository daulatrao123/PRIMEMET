# PRIMEMET — environment variables
#
# NOTHING in this file is required to build or run the current site. Stage 1 has no
# database, no authentication and no mail integration, and the production build must
# never depend on any of these values being present.
#
# Copy to .env.local for local work. .env* is git-ignored except this example file.
# Never commit real credentials — placeholders only, as below.

# ---------------------------------------------------------------------------
# Active now (optional)
# ---------------------------------------------------------------------------
# Absolute site URL used for canonical and Open Graph metadata.
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stage 3 — database (Supabase PostgreSQL). Not read by any code yet.
# ---------------------------------------------------------------------------
# Pooled connection for the application runtime: Supabase Dashboard →
# Project Settings → Database → Connection pooling. Port 6543.
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection used by migrations only. Port 5432.
# DIRECT_URL=postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Stage 2 — authentication session signing. Not read by any code yet.
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# AUTH_SECRET=replace-with-a-random-32-byte-value

# ---------------------------------------------------------------------------
# Stage 2 — outbound mail (Zoho Mail SMTP). Not read by any code yet.
# ---------------------------------------------------------------------------
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=465
# ZOHO_SMTP_USER=enquiries@example.com
# ZOHO_SMTP_PASSWORD=app-specific-password-placeholder
# MAIL_FROM=PRIMEMET <enquiries@example.com>
