{
  "name": "primemet",
  "version": "0.1.0",
  "private": true,
  "description": "PRIMEMET — managed industrial scrap sourcing and spare-parts procurement",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-routes.mjs",
    "check:content": "node scripts/smoke-content.mjs",
    "check:wizard": "node scripts/wizard-interaction.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:schema:m1": "node scripts/check-schema-m1.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "test:site-url": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-site-url.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "check:equivalence": "node scripts/check-equivalence.mjs",
    "db:init": "node scripts/db-init.mjs",
    "db:status": "node scripts/db-init.mjs --status",
    "db:verify": "node scripts/db-init.mjs --verify-only",
    "check:mongodb": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-mongodb.mjs",
    "db:enums": "node scripts/gen-mongo-enums.mjs",
    "db:validate:offline": "node scripts/db-verify.mjs --validate-only",
    "check:enums": "node scripts/check-enums.mjs",
    "audit:unique-indexes": "node scripts/audit-unique-indexes.mjs",
    "verify:unique-index-semantics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-unique-index-semantics.mjs",
    "verify:tax-rule-index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-tax-rule-index.mjs",
    "db:provision": "node db/provision-roles.mjs",
    "db:check-role": "node db/provision-roles.mjs --check",
    "check:migrations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-migration-architecture.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "mongodb": "^7.8.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.35.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@eslint/eslintrc": "3.2.0",
    "@tailwindcss/postcss": "4.0.14",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "mongodb-memory-server": "^10.4.3",
    "prisma": "6.16.2",
    "tailwindcss": "4.0.14",
    "typescript": "5.8.2"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
