{
  "name": "primemet",
  "version": "0.1.0",
  "private": true,
  "description": "PRIMEMET — managed industrial scrap sourcing and spare-parts procurement",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-routes.mjs",
    "check:content": "node scripts/smoke-content.mjs",
    "check:wizard": "node scripts/wizard-interaction.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:schema:m1": "node scripts/check-schema-m1.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "test:site-url": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-site-url.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "check:equivalence": "node scripts/check-equivalence.mjs",
    "db:init": "node scripts/db-init.mjs",
    "db:guard": "node scripts/db-guard.mjs",
    "check:db-guard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-db-guard.mjs",
    "db:status": "node scripts/db-init.mjs --status",
    "db:verify": "node scripts/db-init.mjs --verify-only",
    "check:mongodb": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-mongodb.mjs",
    "db:enums": "node scripts/gen-mongo-enums.mjs",
    "db:validate:offline": "node scripts/db-verify.mjs --validate-only",
    "check:enums": "node scripts/check-enums.mjs",
    "audit:unique-indexes": "node scripts/audit-unique-indexes.mjs",
    "verify:unique-index-semantics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-unique-index-semantics.mjs",
    "verify:tax-rule-index": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-tax-rule-index.mjs",
    "db:provision": "node db/provision-roles.mjs",
    "db:check-role": "node db/provision-roles.mjs --check",
    "check:migrations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-migration-architecture.mjs",
    "check:permissions": "node --disable-warning=ExperimentalWarning scripts/check-permissions.mjs",
    "check:adversarial": "node --disable-warning=ExperimentalWarning scripts/check-adversarial.mjs",
    "check:bootstrap": "node --disable-warning=ExperimentalWarning scripts/check-bootstrap.mjs",
    "check:bootstrap-cli": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-bootstrap-cli.mjs",
    "check:registration": "node --disable-warning=ExperimentalWarning scripts/check-registration.mjs",
    "check:acceptance": "node --disable-warning=ExperimentalWarning scripts/check-acceptance.mjs",
    "report:tier-matrix": "node --disable-warning=ExperimentalWarning scripts/report-tier-matrix.mjs",
    "check:remediation": "node --disable-warning=ExperimentalWarning scripts/check-remediation.mjs",
    "check:authz": "node --disable-warning=ExperimentalWarning scripts/check-authz-authenticated.mjs",
    "audit:permission-integrity": "node --disable-warning=ExperimentalWarning scripts/audit-permission-integrity.mjs",
    "db:backfill-organisations": "node scripts/backfill-organisations.mjs",
    "db:bootstrap": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/bootstrap-organisation.mjs",
    "verify:m1": "node --import ./scripts/lib/register-ts.mjs scripts/verify-m1.mjs",
    "check:env-blank": "node --import ./scripts/lib/register-ts.mjs scripts/check-env-blank.mjs",
    "verify:m2": "node scripts/verify-m2.mjs",
    "verify:m3": "node scripts/verify-m3.mjs",
    "verify:m4": "node scripts/verify-m4.mjs --group ALL",
    "verify:m5": "node scripts/verify-m5.mjs --group ALL",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "verify:b2": "node --disable-warning=ExperimentalWarning scripts/verify-b2-migration.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "mongodb": "^7.8.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.35.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@eslint/eslintrc": "3.2.0",
    "@tailwindcss/postcss": "4.0.14",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "mongodb-memory-server": "^10.4.3",
    "prisma": "6.16.2",
    "tailwindcss": "4.0.14",
    "typescript": "5.8.2"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
